{
  "extends": ["@tsconfig/node22/tsconfig.json", "@vue/tsconfig/tsconfig.json"],
  "compilerOptions": {

    "target": "ESNext",
    "jsx": "preserve",
    "lib": ["esnext", "dom"],

    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@comp/*": ["./src/components/*"]
    },
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],

    "allowJs": true,
    // "composite": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [".vitepress/**/*", "src/**/*"],
  "exclude": [
    "node_modules",
    ".vitepress/dist",
    ".vitepress/.temp",
    ".vitepress/.cache"
  ]
}
